<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Zero-warning ratchet (2026-08-01, portfolio-wide): a new warning is a build break. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Deliberate override of the props-level net10.0-windows default: the core is the TFM-neutral
         layer of the diagnostics stack (diagnostics-platform-layering spec) so any platform — including
         future non-Windows consumers — can reference it. Platform-only code (screen capture) lives in
         Astronomy.Diagnostics.Windows; a Windows API appearing here should FAIL the build, not compile. -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Astronomy.Diagnostics</RootNamespace>
    <AssemblyName>Astronomy.Diagnostics</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- The Log API documents its convention-bearing members; CS1591 is suppressed so the obvious severity
         siblings + the config record's positional properties don't need per-member docs. CA1031: a best-effort
         logger / screen-capture intentionally swallows every exception so a diagnostics failure can never escalate
         into the caller. -->
    <NoWarn>$(NoWarn);CS1591;CA1031</NoWarn>
    <!-- AnyCPU enables a standalone `dotnet build`; the SLN-driven build is x64. Matches Astronomy.Catalog/.XISF. -->
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- ObservationSession's internal ctor is the unit-test seam (fake capture delegates, no real screen grab). -->
    <InternalsVisibleTo Include="Astronomy.Diagnostics.Tests" />
  </ItemGroup>

</Project>
