<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Zero-warning ratchet (2026-08-01, portfolio-wide): a new warning is a build break. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Astronomy.XISF</RootNamespace>
    <AssemblyName>Astronomy.XISF</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- AnyCPU enables `dotnet build Astronomy.XISF/Astronomy.XISF.csproj` for the
         pure-managed standalone build; the SLN-driven build is x64-only and selects
         x64 explicitly via Platforms multi-list. Matches Astronomy.Core. -->
    <Platforms>AnyCPU;x64</Platforms>
    <ProjectGuid>{4E8A3B91-6C72-4D85-9B14-7F3D8E6C2A91}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Astronomy.XISF.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>

  <!-- Tier 1 (2026-05-18): header-only read. Tier 3 (2026-08-06): full-codec block
       compression + image read. Pure managed (LZ4/zstd via managed-only packages);
       no native deps; no NINA / Profile / WPF coupling. T2 (header write-back) and
       T4 (image write) tracked in ROADMAP.md. -->

</Project>
