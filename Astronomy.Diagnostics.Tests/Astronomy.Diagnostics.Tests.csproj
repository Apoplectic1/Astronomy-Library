<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Warnings broke through once (45 xUnit1051s accumulated silently, 2026-08-01);
         a new warning is now a build break. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Tests use null literals to verify ArgumentNullException paths; matches
         Astronomy.Core.Tests / Astronomy.NINA.Tests convention. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
    <ProjectGuid>{A5E9C1D7-4B28-4F63-9E15-7D3A8C2F6B41}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astronomy.Diagnostics\Astronomy.Diagnostics.csproj" />
  </ItemGroup>

</Project>
