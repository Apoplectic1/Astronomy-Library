<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Zero-warning ratchet (2026-08-01, portfolio-wide): a new warning is a build break. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The Windows capture backend of the diagnostics stack: the platform-only piece (Win32 screen grab)
         extracted from the now TFM-neutral core so any platform can host the core. Namespace stays
         Astronomy.Diagnostics — consumers see one surface split across layered assemblies. -->
    <RootNamespace>Astronomy.Diagnostics</RootNamespace>
    <AssemblyName>Astronomy.Diagnostics.Windows</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- CA1031: the capture backend is best-effort by contract — it swallows every exception so a
         diagnostics failure can never escalate into the caller. CS1591 matches the core's policy. -->
    <NoWarn>$(NoWarn);CS1591;CA1031</NoWarn>
    <!-- AnyCPU enables a standalone `dotnet build`; the SLN-driven build is x64. Matches the core. -->
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <!-- Win32 screen-pixel capture (ScreenCapture.ToPng -> Graphics.CopyFromScreen); Windows-only
         package — the reason this layer exists apart from the net10.0 core. -->
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astronomy.Diagnostics\Astronomy.Diagnostics.csproj" />
  </ItemGroup>

</Project>
