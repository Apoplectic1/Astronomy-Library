<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Zero-warning ratchet (2026-08-01, portfolio-wide): a new warning is a build break. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Astronomy.Catalog</RootNamespace>
    <AssemblyName>Astronomy.Catalog</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- API surface (SchemaManager, mappers, store, TS reader, enums) is documented; the DB-mirror POCOs are
         1:1 with the documented migration SQL, so CS1591 is suppressed rather than spamming per-column docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- AnyCPU enables `dotnet build Astronomy.Catalog/Astronomy.Catalog.csproj` for the
         pure-managed standalone build; the SLN-driven build is x64-only. Matches Astronomy.XISF. -->
    <Platforms>AnyCPU;x64</Platforms>
    <ProjectGuid>{A1C2E3F4-5B6D-4789-A0B1-C2D3E4F5A6B7}</ProjectGuid>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Security pin (CVE-2025-6965 / GHSA-2m69-gcr7-jv3q, NU1903): Microsoft.Data.Sqlite 10.0.9
         transitively pulls the native engine SQLitePCLRaw.lib.e_sqlite3 2.1.11, and the advisory
         affects all versions <= 2.1.11 (no 2.1.12 — SQLitePCLRaw renumbered to a 3.x line). Pinning
         the bundle to 3.0.3 (lib 3.50.3 = SQLite >= 3.50.2, patched) overrides the transitive 2.1.11
         coherently across core/provider/native. Flows to every consumer; revisit when Microsoft.Data.Sqlite
         ships a build that references the 3.x line itself. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
    <!-- The library scanner (Scan/) reads XISF headers via Astronomy.XISF. -->
    <ProjectReference Include="..\Astronomy.XISF\Astronomy.XISF.csproj" />
    <!-- Framing comparison (Scan/FramingCluster) needs the sky-footprint geometry in Astronomy.Core, so the
         overlap rule can sit beside the serve/does-not-serve rule it must never drift from. Core is the
         dependency-free base, so this is acyclic. -->
    <ProjectReference Include="..\Astronomy.Core\Astronomy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Astronomy.Catalog.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schema\schema.sql" />
  </ItemGroup>

  <!-- Pure managed (Microsoft.Data.Sqlite + Astronomy.XISF for the scanner); no native deps.
       Consumer UIs live in their own repos — this library is the schema/build contract only. -->

</Project>
