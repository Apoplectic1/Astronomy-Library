# https://editorconfig.org/
root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

# Project files and structured data — 2-space convention in the .NET ecosystem.
[*.{csproj,vcxproj,vcxproj.filters,props,targets,sln,json,xml,yml,yaml}]
indent_size = 2

# Trailing whitespace is meaningful in Markdown (two spaces = line break).
[*.md]
trim_trailing_whitespace = false
