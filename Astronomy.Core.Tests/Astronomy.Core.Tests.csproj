<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <!-- Tests deliberately pass null literals at call sites to verify
         ArgumentNullException paths in the Library. Enabling nullable here would
         cascade null! suppressions to ~200+ test sites for zero behavioral
         benefit. The Library itself ships nullable-enabled annotations; tests
         verify runtime contract, not compile-time. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0-pre.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Astronomy.Core\Astronomy.Core.csproj" />
    <ProjectReference Include="..\Astronomy.PCL\Astronomy.PCL.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PCL\src\utils\xisf\TestData\test.xisf"
          Condition="Exists('..\PCL\src\utils\xisf\TestData\test.xisf')">
      <Link>TestData\test.xisf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
